{
  "info": {
    "name": "Aster — конфигуратор (prof-mast)",
    "description": "Тесты API. Запускайте папки по порядку (Collection Runner): cookie сессии Postman хранит сам.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "user@test.by"
    },
    {
      "key": "password",
      "value": "secret123"
    }
  ],
  "item": [
    {
      "name": "1. Каталог и расчёт (без входа)",
      "item": [
        {
          "name": "Каталог",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Есть models, trims, colors, options', () => ['models','trims','colors','options'].forEach(k => pm.expect(j).to.have.property(k)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Расчёт: корректная конфигурация",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/quote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "quote"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"X\",\n  \"trim\": \"premium\",\n  \"color\": \"red\",\n  \"options\": [\n    \"leather\",\n    \"wheels\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Ничего не снято', () => pm.expect(j.removed).to.have.lengthOf(0));",
                  "pm.test('Итого 5 075 000', () => pm.expect(j.total).to.eql(5075000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Расчёт: конфликт опций (спорт-сиденья + кожа, фаркоп + диски)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/quote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "quote"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"X\",\n  \"trim\": \"premium\",\n  \"color\": \"red\",\n  \"options\": [\n    \"leather\",\n    \"sportseat\",\n    \"wheels\",\n    \"tow\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Сервер снял 2 несовместимые опции', () => pm.expect(j.removed).to.have.lengthOf(2));",
                  "pm.test('Осталось leather и wheels', () => pm.expect(j.config.options).to.have.members(['leather','wheels']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Расчёт: цвет и опция недоступны для Comfort",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/quote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "quote"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"S\",\n  \"trim\": \"comfort\",\n  \"color\": \"red\",\n  \"options\": [\n    \"roof\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Цвет сброшен на white', () => pm.expect(j.config.color).to.eql('white'));",
                  "pm.test('Опция roof снята', () => pm.expect(j.config.options).to.have.lengthOf(0));",
                  "pm.test('Причины сообщены', () => pm.expect(j.removed).to.have.lengthOf(2));"
                ]
              }
            }
          ]
        }
      ]
